{
  "name": "hope-of-light",
  "version": "1.0.0",
  "description": "Hope of Light — NGO website with Express + MySQL backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "create-admin": "node scripts/create-admin.js",
    "db:init:cloud": "node --env-file=.env.cloud scripts/init-db.js",
    "create-admin:cloud": "node --env-file=.env.cloud scripts/create-admin.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
